# Local-only credentials for the loopback-bound Docker database.
DATABASE_URL=postgresql://kvarta:kvarta_local@127.0.0.1:54329/kvarta
# Optional locally; use Neon's DIRECT (not pooled) URL at release.
DATABASE_URL_DIRECT=postgresql://kvarta:kvarta_local@127.0.0.1:54329/kvarta

# Offline simulator: success, transient, transient-once, throttled,
# throttled-once, terminal, timeout. Never controlled by visitor input.
TELEGRAM_TRANSPORT=mock
TELEGRAM_MOCK_SCENARIO=success
# Real bot configuration belongs to the final release step. Leave blank locally.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional local management access; blank disables it. Generate with:
# node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
CRON_SECRET=
