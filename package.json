{
  "name": "kvarta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:db && npm run build",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.ts up",
    "db:rollback": "node scripts/migrate.ts down",
    "db:check": "node --conditions=react-server scripts/db-check.ts",
    "test:db": "node scripts/test-db.ts"
  },
  "dependencies": {
    "@next/env": "16.4.2",
    "libphonenumber-js": "1.13.15",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.0",
    "globals": "17.13.0",
    "node-pg-migrate": "9.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
